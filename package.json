{
  "name": "shrink",
  "description": "Mobile device simulator browser extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:arc": "CHROME_PATH=\"/Applications/Arc.app/Contents/MacOS/Arc\" wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "^1.59.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.25"
  }
}
