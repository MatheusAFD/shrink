{
  "name": "shrink-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Shrink monorepo — browser extension + landing page",
  "type": "module",
  "scripts": {
    "dev:ext": "pnpm --filter @shrink/extension dev",
    "dev:ext:firefox": "pnpm --filter @shrink/extension dev:firefox",
    "dev:lp": "pnpm --filter @shrink/landing-page dev",
    "build:ext": "pnpm --filter @shrink/extension build",
    "build:ext:firefox": "pnpm --filter @shrink/extension build:firefox",
    "build:lp": "pnpm --filter @shrink/landing-page build",
    "test": "pnpm --filter @shrink/extension test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
